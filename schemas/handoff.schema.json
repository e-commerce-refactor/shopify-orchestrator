{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShopifyAgentHandoff",
  "type": "object",
  "required": ["status", "summary", "artifacts", "evidence", "assumptions", "risks", "blockers", "gate_results", "recommended_next_action"],
  "properties": {
    "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
    "summary": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "schema_version", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "schema_version": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "collected_at", "method", "confidence"],
        "properties": {
          "source": { "type": "string" },
          "collected_at": { "type": "string", "format": "date-time" },
          "method": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "result", "details"],
        "properties": {
          "criterion": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail", "not_applicable"] },
          "details": { "type": "string" }
        }
      }
    },
    "recommended_next_action": { "type": "string" }
  }
}